{
    "name": "GestureMeme",
    "description": "Bringing Youtube to Life",
    "version": "0.1",
    "manifest_version": 3,
    "action":{
        "default_popup": "popup.html",
        "default_icon": "Cool-Sunglasses-Troll-Face.png"
    },
    "content_scripts": [
        {
            "js": ["content.js"],
            "matches": [
                "https://www.youtube.com/*"
            ]
        }
    ]
}